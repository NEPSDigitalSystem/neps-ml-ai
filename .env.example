# ═════════════════════════════════════════════════════════════════════════════
# NEPS ML/AI — Environment Variables
# ═════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# WARNING: Never commit .env to git — it contains secrets!
# ═════════════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 1: Application Configuration
# ═════════════════════════════════════════════════════════════════════════════

APP_NAME=NEPS ML/AI Service
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# Environment mode: development | staging | production
ENVIRONMENT=development

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 2: Data Source (PostgreSQL — single source of truth)
# ═════════════════════════════════════════════════════════════════════════════
# ML/AI reads V3.1 baseline data and derived scores from PostgreSQL (tables
# nds_v31_source / nds_v31_derived). It does NOT connect to REDCap directly.
# Whether PostgreSQL is populated from mock or real REDCap is a Data Platform
# concern (REDCAP_API_URL / REDCAP_MOCK_ENABLED there), not an ML/AI setting.

# Preferred in Docker: read the password from a mounted secret and build the URL.
DATABASE_URL_FILE=/run/secrets/postgres_password

# TLS mode used when the URL is built from DATABASE_URL_FILE
DATABASE_SSL_MODE=require

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 3: Security & Authentication
# ═════════════════════════════════════════════════════════════════════════════

# Secret key for encryption, JWT signing, sessions
# IMPORTANT: Change this in production!
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# JWT Configuration
JWT_ALGORITHM=ES256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 4: Database (PostgreSQL)
# ═════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection settings
POSTGRES_USER=neps
POSTGRES_PASSWORD=neps_password
POSTGRES_DB=neps_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full database URL
DATABASE_URL=postgresql://neps:neps_password@postgres:5432/neps_db

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 5: Redis Cache & Sessions
# ═════════════════════════════════════════════════════════════════════════════

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Alternative Redis settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis connection pool size
REDIS_POOL_SIZE=20

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 6: API Configuration
# ═════════════════════════════════════════════════════════════════════════════

# ML/AI Service API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 7: ML/AI Specific Settings
# ═════════════════════════════════════════════════════════════════════════════

# Model settings
MODEL_CACHE_DIR=/app/models
MODEL_BATCH_SIZE=32
MODEL_TIMEOUT=30

# Data processing
DATA_CACHE_TTL=3600
MAX_UPLOAD_SIZE_MB=100

# ═════════════════════════════════════════════════════════════════════════════
# SECTION 8: Monitoring & Logging
# ═════════════════════════════════════════════════════════════════════════════

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ═════════════════════════════════════════════════════════════════════════════
# END OF FILE
# ═════════════════════════════════════════════════════════════════════════════
